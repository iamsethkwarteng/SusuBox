# SusuBox frontend environment. Expo inlines EXPO_PUBLIC_* vars at build time.
# Restart the Expo dev server after changing this file (env is read at startup).

# Backend API base — your machine's Wi-Fi LAN IP so a phone on the same network
# can reach it. Includes the /api prefix the backend mounts all routes under.
# If your LAN IP changes (new network), update this and restart Expo.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api

# Paystack publishable key (safe on the client).
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Cloudinary unsigned client uploads (ID card, selfie, profile photo).
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# HUBTEL PENDING: registration SMS OTP step is skipped while this is not "true".
# Flip to true at the same time as PHONE_OTP_ENABLED=true in the backend .env.
EXPO_PUBLIC_PHONE_OTP_ENABLED=false
